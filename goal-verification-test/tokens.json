{
  "version": "4.2.0",
  "archetype": "quiet-luxury-atelier",
  "polarity": "light",
  "feeling": "calm",
  "folderJitter": -2,
  "variables": {
    "--bg-canvas": "oklch(0.97 0.015 68)",
    "--bg-elevated": "oklch(0.99 0.015 68)",
    "--bg-surface-active": "oklch(0.95 0.018 68)",
    "--bg-glass": "oklch(0.99 0.015 68 / 0.72)",
    "--bg-sunken": "oklch(0.92 0.012 68)",
    "--text-primary": "oklch(0.18 0.005 68)",
    "--text-muted": "oklch(0.46 0.015 68)",
    "--text-subtle": "oklch(0.6 0.018 68)",
    "--text-inverse": "oklch(0.98 0.005 68)",
    "--accent-primary": "oklch(0.50 0.04 60)",
    "--accent-subtle": "oklch(0.50 0.04 60 / 0.12)",
    "--accent-hover": "oklch(0.45 0.05 60)",
    "--border-hairline": "oklch(0.86 0.015 68)",
    "--border-subtle": "oklch(0.91 0.012 68)",
    "--border-focus": "oklch(0.65 0.20 68 / 0.75)",
    "--highlight-specular": "oklch(1 0 0 / 0.60)",
