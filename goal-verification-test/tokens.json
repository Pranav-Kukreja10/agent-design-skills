    "--container-max": "1280px",
    "--font-display": "\"Cormorant Garamond\", serif",
    "--font-sans": "\"Instrument Serif\", serif",
    "--font-mono": "\"Fragment Mono\", monospace",
    "--text-xs": "0.640rem",
    "--text-sm": "0.800rem",
    "--text-base": "1.000rem",
    "--text-lg": "1.250rem",
    "--text-xl": "1.563rem",
    "--text-2xl": "1.953rem",
    "--text-3xl": "2.441rem",
    "--text-4xl": "3.052rem",
    "--weight-heading": "600",
    "--weight-body": "400",
    "--weight-mono": "500",
    "--ease-primary": "cubic-bezier(0.25, 1, 0.5, 1)",
    "--duration-fast": "140ms",
    "--duration-normal": "240ms"
  }
