    "frontend",
    "cli",
    "governance"
  ],
  "author": "Pranav Kukreja",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pranav-Kukreja10/agent-design-skills.git"
  },
  "homepage": "https://github.com/Pranav-Kukreja10/agent-design-skills#readme",
  "bugs": {
    "url": "https://github.com/Pranav-Kukreja10/agent-design-skills/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "pathe": "^1.1.2",
    "picocolors": "^1.1.0"
