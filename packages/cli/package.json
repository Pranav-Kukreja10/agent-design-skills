{
  "name": "agent-design-skills",
  "version": "1.1.5",
  "description": "v1.1 CLI and design-governance registry eliminating AI UI slop and enforcing cross-page unity",
  "type": "module",
  "bin": {
    "agent-design-skills": "dist/index.js",
    "design-skills": "dist/index.js"
  },
  "files": [
