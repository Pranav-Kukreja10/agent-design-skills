  "archetypes": [
    {
      "id": "dark-obsidian-technical",
      "name": "Dark Obsidian Technical",
      "polarity": "dark",
      "path": "archetypes/dark-obsidian-technical.md",
      "hint": "Crisp 1px hairlines, carbon surfaces hue 250, forensic developer/settlement consoles",
      "defaultFeeling": "urgent-precise",
      "defaultRadius": "subtle",
      "defaultBlur": "subtle-frost"
    },
    {
      "id": "editorial-serif-paper",
      "name": "Editorial Serif Paper",
      "polarity": "light",
      "path": "archetypes/editorial-serif-paper.md",
