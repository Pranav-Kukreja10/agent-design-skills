      "defaultFeeling": "playful-tactile",
      "defaultRadius": "sharp",
      "defaultBlur": "flat"
    }
  ],
  "feeling_vectors": {
    "calm": {
      "id": "calm",
      "name": "Calm & Literary",
      "ease": "cubic-bezier(0.25, 1, 0.5, 1)",
      "durationFast": "140ms",
      "durationNormal": "240ms",
      "description": "Unhurried, measured, literary ease"
    },
    "urgent-precise": {
      "id": "urgent-precise",
      "name": "Urgent & Forensic Precision",
      "ease": "cubic-bezier(0.16, 1, 0.3, 1)",
      "durationFast": "110ms",
      "durationNormal": "180ms",
      "description": "Snappy, clinical precision with zero bounce"
    },
    "playful-tactile": {
      "id": "playful-tactile",
      "name": "Playful & Tactile",
      "ease": "cubic-bezier(0, 0, 0.2, 1)",
      "durationFast": "80ms",
      "durationNormal": "150ms",
      "description": "Crisp springy press states and punchy responses"
    },
    "authoritative": {
      "id": "authoritative",
      "name": "Authoritative & Institutional",
      "ease": "cubic-bezier(0.2, 0, 0, 1)",
      "durationFast": "120ms",
      "durationNormal": "200ms",
      "description": "Grounded, stable, institutional transitions"
    }
  },
