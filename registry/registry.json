      "defaultFeeling": "calm",
      "defaultRadius": "sharp",
      "defaultBlur": "flat"
    },
    {
      "id": "neo-brutalism",
      "name": "Neo-Brutalist Studio",
      "polarity": "light",
      "path": "archetypes/neo-brutalism.md",
